# Git attribute macros used by Unity projects
# Legacy LFS patterns remain documented, but assets are stored as normal Git blobs.
[attr]lfs -filter -diff -merge -text
[attr]unity-json eol=lf linguist-language=json
[attr]unity-yaml merge=unityyamlmerge eol=lf linguist-language=yaml

# Documentation
*.md text eol=lf

# Git attribute files
.gitattributes text eol=lf
